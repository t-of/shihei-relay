rules_version = '2';

// 紙幣リレー — Firestore セキュリティルール
// Firebase コンソール > Firestore Database > ルール に貼り付けて「公開」する（README の「Firebase の準備」）。
// 形はここが正本。README の「## データ」と合わせて直す。

service cloud.firestore {
  match /databases/{database}/documents {

    // key = <号券><券種><色>-<記番号> の形と、券種・色・号券・記番号の組み合わせが正しいか。
    // js/bill.js の parseSerial・COLORS と同じ組み合わせだけを許す。
    // ponytail: 数字 6 桁が 000001〜900000 の範囲かまでは正規表現では見ていない
    // （000000・900001 以上は rules の外の値なので、app 側で弾いていれば実害はない）。
    // 数字の範囲まで rules で締めたくなったら、6 桁を 1 桁ずつ書いた正規表現に置き換える。
    // 昔のお札(仕様「19」。今は発行していないが法的に有効)の 6 行を足す。js/bill.js の NOTE_TYPES と同じ組み合わせ。
    function isValidKey(key) {
      return key.matches('^F(10000|5000|1000)K-[A-HJ-NP-Z]{2}[0-9]{6}[A-HJ-NP-Z]{2}$')
          || key.matches('^E(10000|5000)[KB]-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^E1000[KBN]-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^D2000K-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^D(10000|5000)[KB]-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^D1000[KUBG]-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^C(10000|5000|500)K-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^C1000[KU]-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^B(1000|500|100)K-[A-HJ-NP-Z]{1,2}[0-9]{6}[A-HJ-NP-Z]$')
          || key.matches('^B50K-[A-HJ-NP-Z][0-9]{6}[A-HJ-NP-Z]$');
    }

    function signedIn() { return request.auth != null; }
    function isMuniCode(m) {
      return m is string && m.matches('^[0-9]{5}$') && int(m[0:2]) >= 1 && int(m[0:2]) <= 47;
    }

    // 24 時間で 50 回・前回から 30 秒あけているか（users/{uid} をバッチで一緒に更新している前提）
    function withinRate(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      // 初めての人は users/{uid} がまだ無い。無い文書を get するとエラーで拒否になるので、先に exists で見る
      let hadBefore = exists(path) && get(path).data.keys().hasAll(['last']);
      let after = getAfter(path);
      let sinceOk = !hadBefore || request.time - get(path).data.last > duration.value(30, 's');
      let sinceWindow = after.data.since is timestamp
        && (request.time - after.data.since < duration.value(24, 'h') ? after.data.n <= 50 : true);
      return sinceOk && after.data.last == request.time && sinceWindow;
    }

    // sightings の文書 id は、最初の登録が {uid} そのもの、戻ってきたとき（2 件目以降）が
    // {uid}_{n}（n は 1〜3）。1 人が 1 枚のお札に書けるのは、これで最大 4 件まで（js/bill.js と同じ形）。
    function isOwnSightingDocId(docId) {
      return docId == request.auth.uid || docId.matches('^' + request.auth.uid + '_[1-3]$');
    }
    // {uid}_{n} の直前の文書 id（n=1 なら {uid}、それ以外は {uid}_{n-1}）
    function prevSightingDocId(docId) {
      let n = int(docId.split('_')[1]);
      return n == 1 ? request.auth.uid : (request.auth.uid + '_' + string(n - 1));
    }
    // 戻ってきたとき（{uid}_{n}）は、自分の直前の登録が存在し、そこから 3 時間あいていること。
    // 「間にほかの人がいたか」は rules では見ない（紙幣リレーを使っていない人の手を渡って戻る
    // こともあるため。アプリ側では聞いて確かめる）。
    // ponytail: 悪意のあるクライアントが直接書いても、1 枚のお札につき最大 3 件（n=1〜3）・
    // 3 時間おきという上限の中でしか「戻ってきた」を水増しできない。
    function isReturnGapOk(key, docId) {
      let prevPath = /databases/$(database)/documents/bills/$(key)/sightings/$(prevSightingDocId(docId));
      return exists(prevPath) && request.time - get(prevPath).data.at > duration.value(3, 'h');
    }

    // ---- みんなの地図の集計（agg/{id}。仕様「21」） ----

    // 日本時間（JST）の「今日」の agg 文書の id。0 を詰めない（js/bill.js の jstDayId と同じ）
    function jstDayId() {
      let t = request.time + duration.value(9, 'h');
      return 'd' + string(t.year()) + '-' + string(t.month()) + '-' + string(t.day());
    }
    // 鍵の頭（号券+券種+色）から色を取った typeId。'F10000K-…' → 'F10000'（js/bill.js の NOTE_TYPES の id と同じ）
    function typeOfKey(key) {
      let h = key.split('-')[0];
      return h[0:h.size() - 1];
    }
    // 集計を増やしてよいのは、同じバッチで新しい sighting を作ったとき（users/{uid} の b・s が指す
    // sighting が、このバッチの前には無く・後にはある）だけ。増える市区町村・typeId・数もそこから決まる
    // ので、「どこの・どの券種の登録数か」を偽って盛ることはできない。
    function isCountUp() {
      let u = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let sp = /databases/$(database)/documents/bills/$(u.b)/sightings/$(u.s);
      let muni = getAfter(sp).data.muni;
      let ty = typeOfKey(u.b);
      let before = resource == null ? {} : resource.data.m;
      let after = request.resource.data.m;
      let cell0 = before.get(muni, {});
      return signedIn() && withinRate(request.auth.uid)
        && isOwnSightingDocId(u.s) && !exists(sp)
        && request.resource.data.keys().hasOnly(['m', 'v']) && request.resource.data.v == 1
        && after.diff(before).affectedKeys().hasOnly([muni])
        && after[muni].diff(cell0).affectedKeys().hasOnly([ty])
        && after[muni][ty] == cell0.get(ty, 0) + 1;
    }

    match /bills/{key}/sightings/{docId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;

      // 最初の登録
      allow create: if signedIn()
        && docId == request.auth.uid
        && isValidKey(key)
        && request.resource.data.keys().hasOnly(['muni', 'at', 'v'])
        && isMuniCode(request.resource.data.muni)
        && request.resource.data.at == request.time
        && request.resource.data.v == 1
        && withinRate(request.auth.uid);

      // 戻ってきたとき（2 件目以降）
      allow create: if signedIn()
        && docId.matches('^' + request.auth.uid + '_[1-3]$')
        && isValidKey(key)
        && request.resource.data.keys().hasOnly(['muni', 'at', 'v'])
        && isMuniCode(request.resource.data.muni)
        && request.resource.data.at == request.time
        && request.resource.data.v == 1
        && withinRate(request.auth.uid)
        && isReturnGapOk(key, docId);

      allow update: if false;
      allow delete: if signedIn() && isOwnSightingDocId(docId);
    }

    // bills 自体・sightings のコレクショングループでの一覧検索はしない（拒否のまま）

    match /hits/{id} {
      allow list: if request.query.limit <= 50;
      allow get: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['denom', 'from', 'to', 'km', 'mins', 'n', 'at', 'v', 'comeback', 'ty'])
        && request.resource.data.denom in [50, 100, 500, 1000, 2000, 5000, 10000]
        && isMuniCode(request.resource.data.from)
        && isMuniCode(request.resource.data.to)
        && request.resource.data.km is int && request.resource.data.km >= 0 && request.resource.data.km <= 3000
        && request.resource.data.mins is int && request.resource.data.mins >= 0
        && request.resource.data.n is int && request.resource.data.n >= 2 && request.resource.data.n <= 1000
        && (!('comeback' in request.resource.data) || request.resource.data.comeback is bool) // 前の版のアプリは comeback を送らない
        // ty（号券+券種、仕様「21」）は無くてもよいが、あれば今回登録した鍵から取れる号券と同じであること
        // （うその号券を付けて「みんなの地図」の絞り込みを偽れないように）
        && (!('ty' in request.resource.data)
            || request.resource.data.ty == typeOfKey(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.b))
        && request.resource.data.at == request.time
        && request.resource.data.v == 1
        && withinRate(request.auth.uid);

      allow update: if false;
      allow delete: if false;
    }

    // 市区町村ごとの登録の数（記番号は持たない）。1 つの文書に全市区町村をまとめる（agg/all と
    // 日ごとの agg/d<年>-<月>-<日>）。書けるのは、同じバッチで新しい sighting を作ったときに、
    // その市区町村・号券のセルをちょうど +1 するときだけ（isCountUp）。
    match /agg/{id} {
      allow get: if true;
      allow create, update: if (id == 'all' || id == jstDayId()) && isCountUp();
      allow list, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last', 'since', 'n', 'v', 'b', 's'])
        && request.resource.data.last == request.time
        && request.resource.data.v == 1
        // b（今回登録した鍵）・s（今回の sighting の文書 id）は、みんなの地図の集計（agg）を
        // 増やすときの手がかり。無くてもよい（前の版のアプリ・集計を使わない登録は送らない）
        && (!('b' in request.resource.data) || isValidKey(request.resource.data.b))
        && (!('s' in request.resource.data) || request.resource.data.s is string);
    }
  }
}
